<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="false"
    tools:context=".fragments.HomeFragment">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <!--  Settings btn  -->
        <RelativeLayout
            android:id="@+id/lyt_open_menu_settings"
            android:layout_width="100px"
            android:layout_height="100px"
            android:layout_marginTop="20px"
            android:layout_marginStart="140px"
            android:clickable="true"
            android:elevation="0.8dp"
            android:background="@drawable/ellipse_closed">
            <ImageView
                android:id="@+id/button_open_menu_settings"
                android:layout_width="36px"
                android:layout_height="37px"
                android:layout_centerInParent="true"
                android:src="@drawable/cog"/>
        </RelativeLayout>

        <!--  Chat btn  -->
        <RelativeLayout
            android:id="@+id/lyt_open_menu_chat"
            android:layout_width="100px"
            android:layout_height="100px"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="20px"
            android:layout_marginEnd="140px"
            android:clickable="true"
            android:elevation="0.8dp"
            android:background="@drawable/ellipse_closed">
            <ImageView
                android:id="@+id/button_open_menu_chat"
                android:layout_width="36px"
                android:layout_height="37px"
                android:layout_centerInParent="true"
                android:src="@drawable/chat"/>
        </RelativeLayout>

        <!--  Question lyt  -->
        <RelativeLayout
            android:id="@+id/buddy_texte_qst_lyt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="20px"
            android:layout_marginHorizontal="140px"
            android:elevation="0.8dp"
            android:visibility="invisible"
            android:background="@drawable/window_bg"
            android:animateLayoutChanges="true">

            <TextView
                android:id="@+id/buddy_texte_qst"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="300px"
                android:minHeight="100px"
                android:padding="20dp"
                android:scrollbars="vertical"
                android:textColor="#000000"
                android:textSize="20sp" />
        </RelativeLayout>

        <!--  Response lyt  -->
        <RelativeLayout
            android:id="@+id/buddy_texte_resp_lyt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="20px"
            android:layout_marginHorizontal="140px"
            android:layout_marginBottom="20px"
            android:layout_below="@+id/buddy_texte_qst_lyt"
            android:elevation="0.8dp"
            android:visibility="invisible"
            android:background="@drawable/window_bg"
            android:animateLayoutChanges="true">
            <TextView
                android:id="@+id/buddy_texte_resp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#000000"
                android:minHeight="100px"
                android:maxHeight="450px"
                android:scrollbars = "vertical"
                android:textSize="20sp"
                android:padding="10dp"/>
        </RelativeLayout>

    </RelativeLayout>

</FrameLayout>
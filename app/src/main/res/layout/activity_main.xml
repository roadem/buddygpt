<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/view_face"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#00000000"
    tools:context="com.robotique.aevaweb.buddygpt.activities.MainActivity">
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--  Custom Toasts  -->
    <RelativeLayout
        android:id="@+id/custom_toast_info"
        android:layout_width="740px"
        android:layout_height="100px"
        android:layout_marginTop="20px"
        android:layout_marginStart="260px"
        android:background="@drawable/toast_bg"
        android:visibility="gone">
        <ImageView
            android:layout_width="36px"
            android:layout_height="36px"
            android:layout_centerVertical="true"
            android:layout_marginHorizontal="10px"
            android:src="@drawable/toast_info_icon"/>
        <TextView
            android:id="@+id/info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#2B2B2B"
            android:textSize="36px"
            android:textAlignment="textStart"
            android:layout_marginStart="56px"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <!--  MLkit Download View  -->
    <RelativeLayout
        android:id="@+id/launch_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#33000000"
        android:visibility="invisible">

        <ProgressBar
            android:id="@+id/progressBar_MLKitDownload"
            android:layout_width="100px"
            android:layout_height="100px"
            android:layout_centerInParent="true"
            android:indeterminate="true"
            android:indeterminateTint="@color/white"
            android:indeterminateTintMode="src_atop" />

        <ImageView
            android:id="@+id/noNetwork"
            android:layout_width="100px"
            android:layout_height="100px"
            android:layout_centerInParent="true"
            android:src="@drawable/ic_baseline_wifi_off_24"
            android:visibility="gone" />

    </RelativeLayout>



</RelativeLayout>